{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BEStateSchema",
  "type": "object",
  "required": ["language", "architecture", "modules"],
  "additionalProperties": true,
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "framework": { "type": "string" },
    "architecture": { "type": "string", "minLength": 1 },
    "system_style": { "type": "string" },
    "rbac": { "type": "object" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "satisfies_fr"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^BE-[0-9]{2,}$" },
          "name": { "type": "string", "minLength": 2 },
          "satisfies_fr": {
            "type": "array",
            "items": { "type": "string", "pattern": "^FR-[0-9]{2,}$" },
            "minItems": 1
          },
          "validation_rules": { "type": "array", "items": { "type": "string" } },
          "requires_transaction": { "type": "boolean" },
          "error_codes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "minItems": 0
    },
    "error_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "http_status"],
        "properties": {
          "code": { "type": "string" },
          "http_status": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
