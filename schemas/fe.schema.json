{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEStateSchema",
  "type": "object",
  "required": ["tech_stack", "platforms", "screens"],
  "additionalProperties": true,
  "properties": {
    "tech_stack": { "type": "string", "minLength": 1 },
    "architecture_pattern": { "type": "string" },
    "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "satisfies_fr"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^FE-[0-9]{2,}$" },
          "name": { "type": "string", "minLength": 2 },
          "route": { "type": "string" },
          "satisfies_fr": {
            "type": "array",
            "items": { "type": "string", "pattern": "^FR-[0-9]{2,}$" },
            "minItems": 1
          },
          "ui_states": { "type": "array", "items": { "type": "string" } },
          "user_actions": { "type": "array", "items": { "type": "string" } },
          "consumes_api": {
            "type": "array",
            "items": { "type": "string", "pattern": "^API-[0-9]{2,}$" }
          },
          "state_holders": { "type": "array", "items": { "type": "string" } },
          "critical_business_logic": { "type": "boolean" }
        }
      },
      "minItems": 0
    }
  }
}
